{
  "tags": [
    "consensus", "execution", "storage", "compilation", "linting", "crypto", "zk",
    "rpc", "api", "indexing", "sdk", "wallet", "ui", "cli", "config", "deployment",
    "testing", "release", "observability", "security", "contracts", "governance",
    "bridge", "dex", "automation", "ai", "docs", "unmapped"
  ],
  "repos": {
    "cometbft": {
      "summary": "CometBFT consensus engine (Go binary, run by xian-stack). Not in this workspace; shown because every tx passes through it.",
      "external": true,
      "capabilities": [
        {"id": "rpc", "name": "JSON-RPC / WebSocket", "tags": ["rpc"], "languages": ["Go"],
         "summary": "broadcast_tx_*, abci_query, status, block and event subscriptions."},
        {"id": "consensus", "name": "Consensus, mempool & P2P", "tags": ["consensus"], "languages": ["Go"],
         "summary": "BFT consensus, mempool, block store and gossip. Drives the app through ABCI."}
      ]
    },
    "postgres": {
      "summary": "PostgreSQL database used by the blockchain data service (BDS).",
      "external": true,
      "capabilities": [
        {"id": "db", "name": "PostgreSQL", "tags": ["storage", "indexing"], "languages": ["SQL"],
         "summary": "Indexed blocks, txs, events, balances and DEX candles."}
      ]
    },
    "solana": {
      "summary": "External chain the bridge settles against.",
      "external": true,
      "capabilities": [
        {"id": "chain", "name": "Solana network", "tags": ["bridge", "rpc"], "languages": ["Rust"],
         "summary": "Reached by xian-bridge over Solana JSON-RPC."}
      ]
    },

    "xian-abci": {
      "summary": "The Xian node application: answers CometBFT's ABCI calls and executes transactions.",
      "capabilities": [
        {"id": "abci-server", "name": "ABCI server", "tags": ["consensus", "rpc"],
         "summary": "Socket server that speaks the ABCI protocol with CometBFT and dispatches to method handlers.",
         "paths": ["src/abci/*", "src/xian/xian_abci.py"]},
        {"id": "protobuf", "name": "CometBFT protobuf types", "tags": ["rpc"],
         "summary": "Generated Python protobuf bindings for the CometBFT wire format.",
         "paths": ["src/tendermint/*", "src/gogoproto/*"]},
        {"id": "methods", "name": "ABCI method handlers", "tags": ["consensus", "execution"],
         "summary": "check_tx, prepare/process_proposal, finalize_block, commit, query, init_chain and their helpers.",
         "paths": ["src/xian/methods/*"]},
        {"id": "execution", "name": "Tx & block execution", "tags": ["execution"],
         "summary": "Execution engine, processor, fee and mempool policy, nonces, simulator.",
         "paths": ["src/xian/execution_engine.py", "src/xian/execution_policy.py", "src/xian/processor.py",
                   "src/xian/simulator.py", "src/xian/fee_policy.py", "src/xian/nonce.py",
                   "src/xian/mempool_policy.py", "src/xian/runtime_features.py",
                   "src/xian/utils/tx.py", "src/xian/utils/block.py"]},
        {"id": "validators", "name": "Validators & evidence", "tags": ["consensus", "governance"],
         "summary": "Validator set updates, evidence and penalty policy, checkpoint validation.",
         "paths": ["src/xian/validators.py", "src/xian/evidence_policy.py", "src/xian/checkpoint_validation.py"]},
        {"id": "state", "name": "State, snapshots & sync", "tags": ["storage"],
         "summary": "State roots, export, snapshots and restore, state sync, full-node store.",
         "paths": ["src/xian/state_*.py", "src/xian/snapshot_*.py", "src/xian/full_node_store*.py",
                   "src/xian/recovery_genesis.py", "src/xian/services/state_sync.py",
                   "src/xian/services/snapshot_limits.py", "src/xian/utils/state_patches.py"]},
        {"id": "bds", "name": "Blockchain data service", "tags": ["indexing", "storage"],
         "summary": "Indexes blocks, txs and events into PostgreSQL, builds DEX candles, reindexing.",
         "paths": ["src/xian/services/bds/*"]},
        {"id": "genesis", "name": "Genesis builder", "tags": ["config"],
         "summary": "Builds the genesis state from network config and system contracts.",
         "paths": ["src/xian/genesis_builder.py"]},
        {"id": "node-config", "name": "Node config & setup", "tags": ["config"],
         "summary": "Node config files, defaults, paths and CometBFT config helpers.",
         "paths": ["src/xian/node_*.py", "src/xian/config_*.py", "src/xian/constants.py",
                   "src/xian/toml_utils.py", "src/xian/utils/cometbft.py"]},
        {"id": "cli", "name": "Node admin CLI", "tags": ["cli"],
         "summary": "Snapshot, export, reindex and node-configuration commands.",
         "paths": ["src/xian/cli/*"]},
        {"id": "observability", "name": "Logging, metrics & dashboard", "tags": ["observability", "ui"],
         "summary": "Structured logging, log retention and safety, metrics, perf counters and the node dashboard.",
         "paths": ["src/xian/app_logging.py", "src/xian/log_*.py", "src/xian/metrics.py", "src/xian/perf.py",
                   "src/xian/dashboard/*"]},
        {"id": "helpers", "name": "Shared helpers", "tags": [],
         "summary": "Encoding, formatting, exceptions and other utilities.",
         "paths": ["src/xian/*"]},
        {"id": "scripts", "name": "Dev & release scripts", "tags": ["release"],
         "paths": ["scripts/*", "*.py"]}
      ]
    },

    "xian-contracting": {
      "summary": "Smart-contract toolchain: compiler, Rust VM, storage and the Python runtime around them.",
      "capabilities": [
        {"id": "linting", "name": "Contract linting & conformance", "tags": ["linting", "compilation"],
         "summary": "Python-side lint rules, whitelists and conformance checks for contract source.",
         "paths": ["src/contracting/compilation/linter.py", "src/contracting/compilation/whitelists.py",
                   "src/contracting/compilation/*conformance.py"]},
        {"id": "compiler-py", "name": "Compilation pipeline (Python)", "tags": ["compilation"],
         "summary": "Parser, IR, lowering and artifacts; hands off to the Rust compiler core.",
         "paths": ["src/contracting/compilation/*", "src/contracting/compiler/*", "src/contracting/artifacts/*"]},
        {"id": "compiler-core", "name": "Compiler core", "tags": ["compilation", "linting"],
         "summary": "Rust compiler frontend, IR, lint and hashing; shipped to Python (PyO3) and to JS as @xian-tech/compiler (WASM).",
         "paths": ["packages/xian-compiler-core/*"]},
        {"id": "vm-bindings", "name": "VM bindings (Python & WASM)", "tags": ["execution"],
         "summary": "PyO3 and WASM entry points into the VM, published as xian_vm_core and @xian-tech/vm.",
         "paths": ["packages/xian-vm-core/src/*python*.rs", "packages/xian-vm-core/src/wasm_bindings.rs",
                   "packages/xian-vm-core/python/*", "packages/xian-vm-core/npm/*"]},
        {"id": "vm-block", "name": "VM block executor & host", "tags": ["execution"],
         "summary": "Block/bundle executor, tx admission and inputs, settlement, rewards, deploy and host calls.",
         "paths": ["packages/xian-vm-core/src/block_*", "packages/xian-vm-core/src/bundle_executor.rs",
                   "packages/xian-vm-core/src/settlement.rs", "packages/xian-vm-core/src/transaction_*",
                   "packages/xian-vm-core/src/tx_rewards.rs"]},
        {"id": "vm-metering", "name": "Metering (chi)", "tags": ["execution"],
         "summary": "Work metering and chi accounting.",
         "paths": ["packages/xian-vm-core/src/metering.rs", "packages/xian-vm-core/src/work_meter.rs"]},
        {"id": "vm-storage", "name": "VM state storage", "tags": ["storage"],
         "summary": "LMDB environment, committed and in-memory stores, stored-value encoding, state roots.",
         "paths": ["packages/xian-vm-core/src/lmdb_*", "packages/xian-vm-core/src/*_store.rs",
                   "packages/xian-vm-core/src/foreign_storage.rs", "packages/xian-vm-core/src/storage_*",
                   "packages/xian-vm-core/src/stored_value*", "packages/xian-vm-core/src/state_*"]},
        {"id": "vm-sandbox", "name": "VM sandbox", "tags": ["execution", "security"],
         "paths": ["packages/xian-vm-core/src/sandbox/*"]},
        {"id": "numeric", "name": "Numeric & decimal semantics", "tags": ["execution"],
         "paths": ["packages/xian-numeric/*", "packages/xian-vm-core/src/decimal_*",
                   "packages/xian-vm-core/src/numeric_*", "packages/xian-vm-core/src/rounding.rs"]},
        {"id": "zk", "name": "Zero-knowledge proofs", "tags": ["zk", "crypto"],
         "summary": "Proof verification and shielded-pool support (Rust core plus Python wrapper).",
         "paths": ["packages/xian-zk/*", "packages/xian-vm-core/src/zk_*"]},
        {"id": "vm-interpreter", "name": "VM interpreter & builtins", "tags": ["execution"],
         "summary": "Interpreter, expression/statement evaluation, builtins, values and string handling.",
         "paths": ["packages/xian-vm-core/*"]},
        {"id": "fastpath", "name": "Fastpath core", "tags": ["execution"],
         "paths": ["packages/xian-fastpath-core/*"]},
        {"id": "runtime-types", "name": "Runtime types", "tags": ["execution"],
         "paths": ["packages/xian-runtime-types/*"]},
        {"id": "accounts", "name": "Accounts & keys", "tags": ["crypto"],
         "paths": ["packages/xian-accounts/*"]},
        {"id": "storage-py", "name": "Contract storage driver", "tags": ["storage"],
         "summary": "Python storage driver and ORM over the native LMDB store.",
         "paths": ["src/contracting/storage/*"]},
        {"id": "execution-py", "name": "Execution client", "tags": ["execution"],
         "summary": "Python execution API and local client on top of the native VM.",
         "paths": ["src/contracting/execution/*", "src/contracting/local/*"]},
        {"id": "stdlib", "name": "Contract stdlib & crypto bridge", "tags": ["execution", "crypto"],
         "paths": ["src/contracting/stdlib/*"]},
        {"id": "core", "name": "Package core", "tags": [],
         "paths": ["src/contracting/*"]},
        {"id": "scripts", "name": "Build & release scripts", "tags": ["release"],
         "paths": ["scripts/*"]}
      ]
    },

    "xian-configs": {
